# Normalize line endings. Git stores text as LF; Windows checkouts get native.
* text=auto

# Source & config: force LF (cross-platform tooling/CI expect it).
*.py     text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.txt    text eol=lf

# Windows scripts must stay CRLF.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary assets: never normalize or diff as text.
*.wav    binary
